# Staging env vars for the SHOP-OWNER frontend (Vite).
#
# On Vercel: Project -> Settings -> Environment Variables, add this scoped to
# "Preview" (the `staging` branch deploys as a Preview and inherits
# Preview-scoped vars). Production keeps its own value under "Production".
#
# Note: Vite exposes only VITE_-prefixed vars to the client bundle.
# The backend host below matches the staging service defined in
# backend/render.yaml (delhiveryway-backend-staging).

VITE_API_URL=https://delhiveryway-backend-staging.onrender.com/api
